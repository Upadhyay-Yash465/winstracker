# Copy to .env.local and fill in.
# Without MONGODB_URI the app runs on an in-memory store (data resets on restart).
MONGODB_URI=
# Any long random string. Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=

# SMTP for signup email verification codes. If these are unset, codes are logged
# to the server console instead of emailed (fine for local dev).
# Gmail: host smtp.gmail.com, port 465, user your address, pass an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wins <you@example.com>"
